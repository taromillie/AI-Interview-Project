# ===== 应用 =====
APP_NAME="AI 模拟面试官与职业规划系统"
DEBUG=true
# 日志级别：DEBUG / INFO / WARNING / ERROR（docker-compose 已透传）
LOG_LEVEL=INFO

# ===== 数据库 =====
# MVP 使用 SQLite；生产可切换 PostgreSQL，如:
# postgresql+psycopg://user:pass@localhost:5432/ai_interview
DATABASE_URL=sqlite:///./app.db

# ===== 向量库 =====
VECTOR_DB_PATH=./data/chroma
EMBEDDING_MODEL=BAAI/bge-m3

# ===== 安全 =====
# 生产环境务必替换！
JWT_SECRET=please-change-this-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
# AES-256 需要 32 字节密钥
AES_KEY=please-change-this-aes-key-32bytes!

# ===== CORS =====
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ===== 默认模型（用户未配置时可选）=====
DEFAULT_LLM_MODEL=gpt-4o-mini
DEFAULT_LLM_BASE_URL=https://api.openai.com/v1
