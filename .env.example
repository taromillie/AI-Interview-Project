# ============================================================
# AI 模拟面试官与职业规划系统 — Docker 部署环境变量
# 用法：复制为 .env 后按需修改（docker compose 启动时自动读取）
#   Windows:  copy .env.example .env
#   macOS/Linux: cp .env.example .env
# 所有项均有默认值，不改也能直接启动。
# ============================================================

# ---- 安全（生产环境务必修改！）----
# JWT 签名密钥：任意长随机字符串（如 openssl rand -hex 32 生成）
JWT_SECRET=please-change-this-secret
# AES-256 加密密钥：必须恰好 32 字节
AES_KEY=please-change-this-aes-key-32bytes!

# ---- 岗位采集 ----
# 数据源：jobui（职友集真实岗位，默认）/ builtin（离线示例兜底）/ 逗号分隔组合
JOB_SOURCE_ENABLED=jobui
# 启动后是否立即同步一次岗位数据
JOB_SYNC_ON_STARTUP=true
# 自动同步间隔（小时，0.5 = 30 分钟）
JOB_SYNC_INTERVAL_HOURS=0.5

# ---- 向量检索（可选增强）----
# 不配置则自动降级为关键词检索，仍可正常使用
EMBEDDING_ENABLED=false
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3

# ---- 应用 ----
DEBUG=false
# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
